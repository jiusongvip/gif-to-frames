---
import { Icon } from 'astro-icon/components';
---

<header id="main-nav" class="sticky top-0 z-50 h-16 border-b border-transparent">
  <div class="mx-auto flex h-full max-w-[1400px] items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2 text-sm font-semibold tracking-tight text-ink">
      <span class="flex h-7 w-7 items-center justify-center rounded-md bg-accent text-white shadow-sm">
        <span class="font-mono text-xs font-bold">G</span>
      </span>
      GIF to Frames
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-1 text-sm text-ink-muted md:flex">
      <a href="/gif-to-png-frames" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">GIF to PNG</a>
      <a href="/gif-to-webp-frames" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">GIF to WebP</a>
      <a href="/frames-to-gif" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">Frames to GIF</a>
      <a href="/gif-to-sprite-sheet" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">Sprite sheet</a>
      <a href="/about" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">About</a>
      <a href="/contact" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">Contact</a>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/#tool" class="hidden items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-strong sm:inline-flex">
        <Icon name="tabler:scissors" class="h-4 w-4" />
        Extract frames
      </a>
      <button id="mobile-menu-btn" type="button" aria-label="Open menu" aria-expanded="false" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-line text-ink transition-colors hover:border-accent/40 hover:text-accent md:hidden">
        <Icon name="tabler:menu-2" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-canvas px-4 py-3 md:hidden">
    <nav aria-label="Mobile" class="flex flex-col gap-1 text-sm text-ink-muted">
      <a href="/" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">Home</a>
      <a href="/gif-to-png-frames" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">GIF to PNG frames</a>
      <a href="/gif-to-webp-frames" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">GIF to WebP frames</a>
      <a href="/gif-to-zip-frames" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">GIF to ZIP frames</a>
      <a href="/frames-to-gif" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">Frames to GIF</a>
      <a href="/gif-to-sprite-sheet" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">Sprite sheet</a>
      <a href="/about" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">About</a>
      <a href="/contact" class="rounded-md px-3 py-2 transition-colors hover:bg-accent-soft hover:text-accent">Contact</a>
      <a href="/#tool" class="mt-2 inline-flex items-center justify-center gap-2 rounded-md bg-accent px-4 py-2 font-medium text-white transition-colors hover:bg-accent-strong">
        <Icon name="tabler:scissors" class="h-4 w-4" />
        Extract frames
      </a>
    </nav>
  </div>
</header>
