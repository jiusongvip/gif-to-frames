---
interface Props {
  class?: string;
  withIcon?: boolean;
}

const { class: cls = '', withIcon = false } = Astro.props;

// Rendered as raw HTML (set:html) so the browser output contains HTML entities
// instead of literal email bytes. Cloudflare Email Obfuscation only matches raw
// bytes, so it neither rewrites this link nor injects its parser-blocking
// email-decode.min.js on the page.
const ICON =
  '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"/><path d="M4 6l8 5l8 -5"/></svg>';

const raw = `<a href="mailto:&#104;&#101;&#108;&#108;&#111;&#64;gif-to-frames&#46;com" class="${cls}">${withIcon ? ICON : ''}\n          &#104;&#101;&#108;&#108;&#111;&#64;gif-to-frames&#46;com</a>`;
---

<Fragment set:html={raw} />
