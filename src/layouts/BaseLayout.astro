---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: string;
  robots?: string;
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname || '/', Astro.site).href.replace(/\/$/, ''),
  ogImage = '/og-1200x630.png',
  schema,
  robots,
} = Astro.props;

const absoluteOgImage = new URL(ogImage, Astro.site).href;

const orgSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'GIF to Frames',
  url: 'https://www.gif-to-frames.com/',
  logo: 'https://www.gif-to-frames.com/favicon.svg',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#6d4bf2" />
    {robots && <meta name="robots" content={robots} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GIF to Frames" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:alt" content="GIF to Frames brand image with frame grid motif" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content="Preview of extracted GIF frames" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {schema && <script type="application/ld+json" set:html={schema} />}
    <script type="application/ld+json" set:html={orgSchema} />
  </head>
  <body class="min-h-[100dvh] text-ink">
    <div id="loading-veil" class="loading-veil" aria-hidden="true">
      <div class="text-center">
        <div class="loading-mark mx-auto">
          <span class="font-mono text-sm font-bold">G</span>
        </div>
        <p class="loading-word">GIF to Frames</p>
      </div>
    </div>

    <div id="reading-progress" class="fixed left-0 top-0 z-[9999] h-0.5 bg-accent" style="width:0%;transition:width 0.1s linear"></div>

    <button id="back-to-top" type="button" aria-label="Back to top" class="fixed bottom-5 right-5 z-[9998] hidden h-11 w-11 items-center justify-center rounded-full border border-line bg-canvas text-accent shadow-lg transition-colors hover:border-accent/40" style="display:none">
      <Icon name="tabler:arrow-up" class="h-5 w-5" />
    </button>

    <Nav />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<script is:inline>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Loading ritual
    var veil = document.getElementById('loading-veil');
    if (veil) {
      var dismiss = function () { veil.classList.add('done'); };
      if (reduce) { dismiss(); }
      else {
        setTimeout(dismiss, 800);
        window.addEventListener('load', function () { setTimeout(dismiss, 400); });
      }
    }

    // Split-letter title reveal (starts after the veil lifts)
    setTimeout(function () {
      document.querySelectorAll('[data-split-title]').forEach(function (el) {
        var chars = (el.textContent || '').trim().split('');
        el.textContent = '';
        chars.forEach(function (ch, i) {
          var span = document.createElement('span');
          span.className = 'split-char';
          span.textContent = ch === ' ' ? '\u00A0' : ch;
          span.style.transitionDelay = Math.min(i * 16, 640) + 'ms';
          el.appendChild(span);
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { span.classList.add('in'); });
          });
        });
      });
    }, reduce ? 0 : 900);

    // Reading progress + floating back-to-top
    var bar = document.getElementById('reading-progress');
    var topBtn = document.getElementById('back-to-top');
    var onScroll = function () {
      var h = document.documentElement;
      var pct = (h.scrollTop / (h.scrollHeight - h.clientHeight)) * 100;
      if (bar) bar.style.width = Math.min(pct, 100) + '%';
      if (topBtn) topBtn.style.display = window.scrollY > 600 ? 'flex' : 'none';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    if (topBtn) topBtn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
    var footerTop = document.getElementById('footer-top');
    if (footerTop) footerTop.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });

    // Scroll reveal
    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) entry.target.classList.add('reveal-in');
        });
      },
      { threshold: 0.12 }
    );
    document.querySelectorAll('.reveal').forEach(function (el) { observer.observe(el); });

    // Sticky nav solid state
    var nav = document.getElementById('main-nav');
    if (nav) {
      var onNavScroll = function () { nav.classList.toggle('nav-solid', window.scrollY > 40); };
      onNavScroll();
      window.addEventListener('scroll', onNavScroll, { passive: true });
    }

    // Mobile menu
    var menuBtn = document.getElementById('mobile-menu-btn');
    var mobileMenu = document.getElementById('mobile-menu');
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', function () {
        var open = mobileMenu.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', String(!open));
      });
      mobileMenu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () { mobileMenu.classList.add('hidden'); });
      });
    }
  })();
</script>
