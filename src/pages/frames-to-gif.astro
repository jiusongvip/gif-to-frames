---
import BaseLayout from '../layouts/BaseLayout.astro';
import FramesToGifTool from '../components/FramesToGifTool.astro';

const title = 'Frames to GIF: Make an Animated GIF from Images Online';
const description =
  'Combine PNG, JPG, or WebP images into an animated GIF online. Reorder frames, set delay and loops, and download locally in your browser.';
---

<BaseLayout title={title} description={description} ogImage="/demo/frame-01.png">
  <FramesToGifTool
    showSchema
    sectionId="frames-to-gif"
    titleLevel="h1"
    h1="Frames to GIF"
    lead="Upload PNG, JPG, or WebP frames, drag them into order, set timing and loops, and create a clean animated GIF."
  />

  <section class="mx-auto max-w-[1400px] px-4 pb-20 sm:px-6">
    <div class="max-w-4xl space-y-12">
      <article>
        <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">How to make a GIF from images</h2>
        <div class="mt-5 space-y-4 text-base leading-relaxed text-ink-muted dark:text-ink-muted">
          <p>Choose two or more PNG, JPG, or WebP images, then drag the thumbnails into the order the animation should play. Set the delay between frames and the number of loops before downloading the GIF.</p>
          <p>The frames are assembled locally in your browser. You can add more images, reverse the order, sort by file name, or start a new sequence at any time.</p>
        </div>
      </article>
      <article>
        <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">Useful settings</h2>
        <div class="mt-5 space-y-4 text-base leading-relaxed text-ink-muted dark:text-ink-muted">
          <p>Delay controls how long each frame stays visible in milliseconds. A shorter delay creates faster motion; a longer delay creates pauses.</p>
          <p>Loops controls how many times the animation repeats. A value of 0 makes the GIF loop forever.</p>
        </div>
      </article>
      <article>
        <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">Related tools</h2>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <a href="/gif-to-png-frames/" class="rounded-md border border-line bg-canvas/70 p-4 transition-colors hover:border-accent/40 dark:border-white/10 dark:bg-white/5">
            <span class="text-sm font-semibold text-ink dark:text-white">GIF to PNG Frames</span>
            <span class="mt-1 block text-xs leading-relaxed text-ink-muted dark:text-ink-muted">Export lossless frames with transparency.</span>
          </a>
          <a href="/gif-frame-metadata/" class="rounded-md border border-line bg-canvas/70 p-4 transition-colors hover:border-accent/40 dark:border-white/10 dark:bg-white/5">
            <span class="text-sm font-semibold text-ink dark:text-white">GIF Frame Metadata</span>
            <span class="mt-1 block text-xs leading-relaxed text-ink-muted dark:text-ink-muted">Inspect delay, disposal, and dimensions.</span>
          </a>
          <a href="/gif-to-sprite-sheet/" class="rounded-md border border-line bg-canvas/70 p-4 transition-colors hover:border-accent/40 dark:border-white/10 dark:bg-white/5">
            <span class="text-sm font-semibold text-ink dark:text-white">GIF to Sprite Sheet</span>
            <span class="mt-1 block text-xs leading-relaxed text-ink-muted dark:text-ink-muted">Arrange frames into one game-ready PNG.</span>
          </a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
