---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const title = 'Page Not Found | GIF to Frames';
const description =
  'The page you are looking for does not exist. Return to the free browser-based GIF to frames tool.';
---

<BaseLayout title={title} description={description} robots="noindex, nofollow">
  <section class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center px-4 py-20 text-center sm:px-6">
    <div class="flex h-12 w-12 items-center justify-center rounded-md bg-accent-soft text-accent dark:bg-emerald-300/10 dark:text-emerald-200">
      <Icon name="tabler:ghost" class="h-6 w-6" />
    </div>
    <h1 class="mt-6 text-4xl font-semibold tracking-tight text-ink sm:text-5xl dark:text-white">Page not found</h1>
    <p class="mt-4 max-w-[46ch] text-base leading-relaxed text-ink-muted dark:text-emerald-50/60">
      The page you are looking for does not exist or may have moved. The GIF to frames tool is still available.
    </p>
    <a href="/" class="mt-8 inline-flex items-center gap-2 rounded-md bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accent-strong">
      <Icon name="tabler:arrow-left" class="h-4 w-4" />
      Back to the tool
    </a>
  </section>
</BaseLayout>
