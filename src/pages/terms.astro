---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Terms of Use: How to Use GIF to Frames Freely';
const description =
  'Terms of use for GIF to Frames: how the free browser-based GIF tools may be used, what you own in the outputs, and the limits of our responsibility.';
---

<BaseLayout title={title} description={description} robots="noindex, follow">
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
    <p class="overline">Legal</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Terms of use</h1>

    <div class="mt-10 space-y-8 text-base leading-relaxed text-ink-muted">
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold tracking-tight text-ink">Using the tools</h2>
        <p>
          GIF to Frames is provided free of charge for lawful image and animation work. No account, license key, or attribution is required to process a file or download an output.
        </p>
        <h3 class="text-lg font-semibold tracking-tight text-ink">What you may do</h3>
        <p>
          Extract frames, inspect metadata, build sprite sheets, rebuild GIFs, and use every exported file in personal, commercial, editorial, and educational projects.
        </p>
        <h3 class="text-lg font-semibold tracking-tight text-ink">What you must not do</h3>
        <p>
          Do not attempt to disrupt the service, bypass browser limits, automate bulk loads against the hosting, or process content you do not have permission to use. You keep responsibility for the files you process and the outputs you create.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold tracking-tight text-ink">Your content and outputs</h2>
        <p>
          Because decoding and export happen in your browser, we never receive a copy of your source files. You keep the rights you already hold in your inputs, and exported frames, archives, sprite sheets, and GIFs are yours to use.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold tracking-tight text-ink">No warranty</h2>
        <p>
          The tools are provided “as is”, without warranty of uninterrupted availability or fitness for a particular purpose. Browser decoding behavior varies, so verify important outputs before relying on them.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold tracking-tight text-ink">Changes to these terms</h2>
        <p>
          If these terms change in a way that affects how the tools may be used, this page will be updated and the date below will reflect the revision.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-semibold tracking-tight text-ink">Contact</h2>
        <p>
          Questions about these terms? Email <a href="mailto:hello@gif-to-frames.com" class="text-accent hover:underline">hello@gif-to-frames.com</a> or use the <a href="/contact/" class="text-accent hover:underline">contact page</a>.
        </p>
        <p class="text-sm">Last updated August 25, 2026.</p>
      </section>
    </div>
  </div>
</BaseLayout>
