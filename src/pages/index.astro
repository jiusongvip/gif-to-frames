---
import BaseLayout from '../layouts/BaseLayout.astro';
import GifFrameTool from '../components/GifFrameTool.astro';
import FramesToGifTool from '../components/FramesToGifTool.astro';
import { Icon } from 'astro-icon/components';

const title = 'GIF to Frames: Split GIF into PNG, JPG or WebP Online';
const description =
  'Convert GIF to frames online: split animated GIFs into PNG, JPG, or WebP images, preview every frame, and download as ZIP. Free and local.';

const absoluteOgImage = new URL('/demo/frame-01.png', Astro.site).href;

const demoFrames = Array.from({ length: 8 }, (_, index) => index + 1);

const faqItems = [
  {
    q: 'How do I convert a GIF into separate frames?',
    a: 'Open the tool, upload your GIF, then select all frames or a custom range. Choose PNG, JPG, or WebP and download the selected frames as a ZIP archive.',
  },
  {
    q: 'Is this GIF to frames tool free?',
    a: 'Yes. The tool is free to use, does not add a watermark, and does not require an account or installation.',
  },
  {
    q: 'Will my GIF be uploaded to a server?',
    a: 'No. The page reads and renders the GIF locally in your browser. Your file stays on your device.',
  },
  {
    q: 'Can I open WebP or APNG files here?',
    a: 'Yes. The uploader accepts animated GIF, WebP, and APNG files in browsers that support animated image decoding.',
  },
  {
    q: 'Can I extract only one frame from a GIF?',
    a: 'Yes. Use First frame, Last frame, or click any frame in the filmstrip. Then download the current frame.',
  },
  {
    q: 'Can I keep transparent backgrounds?',
    a: 'Yes. PNG and WebP exports can keep transparency. JPG will use a white background because it does not support alpha.',
  },
  {
    q: 'Can I extract every second, third, or Nth frame?',
    a: 'Yes. Set the start frame, end frame, and Every Nth frame value before exporting.',
  },
  {
    q: 'Can I convert GIF frames to PNG?',
    a: 'Yes. Upload the GIF, choose PNG as the output format, and download the current frame or all selected frames as a ZIP. PNG keeps transparency and clean edges.',
  },
  {
    q: 'Can I split a GIF into frames without uploading it?',
    a: 'Yes. The GIF is read and rendered locally in your browser. Your file is not sent to a server, and no account or installation is required.',
  },
  {
    q: 'How do I make a GIF from images?',
    a: 'Use the Frames to GIF section. Select two or more PNG, JPG, or WebP images, drag them into order, set delay and loops, then click Download GIF.',
  },
  {
    q: 'Can I export GIF frames as a sprite sheet?',
    a: 'Yes. Select the frames you want, choose a scale, and click Sprite sheet. The tool creates one PNG image arranged for game or web animation.',
  },
  {
    q: 'What output formats are supported?',
    a: 'You can export PNG, JPG, or WebP. PNG keeps transparency, JPG creates smaller flattened images, and WebP offers a modern balance of quality and file size.',
  },
  {
    q: 'Can I combine frames back into a GIF?',
    a: 'Yes. Use the Frames to GIF section to upload PNG, JPG, or WebP images, drag them into order, set delay and loop count, then download the new GIF.',
  },
  {
    q: 'What is frame delay?',
    a: 'Frame delay is how long each frame stays visible before the animation moves to the next frame. It is measured in milliseconds and controls the speed and rhythm of a GIF.',
  },
  {
    q: 'What is disposal in GIF metadata?',
    a: 'Disposal tells a decoder how to treat the previous frame before drawing the next one. It is important for transparency, partial-frame animations, and rebuilding a GIF accurately.',
  },
  {
    q: 'Can I process multiple GIF files at once?',
    a: 'Yes. Upload multiple files, switch between them with the job tabs, then use All jobs ZIP to package each source into its own folder.',
  },
  {
    q: 'Can I preview the animation before downloading frames?',
    a: 'Yes. Load a GIF and use the Play control to preview it frame by frame. You can set 0.25×, 0.5×, 1×, or 2× speed before choosing which frames to export.',
  },
  {
    q: 'Why choose PNG instead of JPG for GIF frames?',
    a: 'PNG is lossless and supports transparency, so it is better for logos, UI elements, sprites, and animation frames that need clean edges. JPG is smaller but flattens transparency and may introduce compression artifacts.',
  },
  {
    q: 'Can I change the file name pattern before downloading?',
    a: 'Yes. Use the File naming field with {index} and {source} placeholders. For example, frame-{index} creates frame-001, while {source}-{index} adds the source file name.',
  },
  {
    q: 'What is the maximum file size?',
    a: 'The uploader accepts files up to 100 MB. Very large or complex animations may take longer to decode and export.',
  },
  {
    q: 'Can I extract GIF frames without installing software?',
    a: 'Yes. This tool runs in your browser, so you can extract frames without downloading or installing an application.',
  },
  {
    q: 'Can I use extracted GIF frames in Photoshop or After Effects?',
    a: 'Yes. Export PNG frames with a numbered naming pattern, then import the image sequence into Photoshop, After Effects, Premiere, or another editing application.',
  },
  {
    q: 'Can I turn GIF frames into a sprite sheet?',
    a: 'Yes. Select the frames you want, choose a scale, and click Sprite sheet to download one PNG image arranged for game or web animation.',
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'GIF to Frames',
      url: 'https://gif-to-frames.com/',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any',
      browserRequirements: 'Requires JavaScript',
      inLanguage: 'en',
      dateModified: '2026-08-17',
      image: absoluteOgImage,
      thumbnailUrl: absoluteOgImage,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      featureList: [
        'Extract GIF, WebP, or APNG frames as PNG, JPG, or WebP',
        'Preview frames frame by frame',
        'Play frames with adjustable speed',
        'Select a frame range or every Nth frame',
        'Download selected frames as ZIP',
        'Keep transparent backgrounds for PNG and WebP',
        'Inspect and export GIF frame metadata as JSON or CSV',
        'Reverse selected frames back into a GIF',
        'Create a sprite sheet from selected frames',
        'Batch process multiple GIF files',
        'Create custom frame file names',
        'Combine PNG, JPG, or WebP frames into a GIF',
      ],
    },
    {
      '@type': 'HowTo',
      name: 'How to extract frames from a GIF',
      image: absoluteOgImage,
      totalTime: 'PT1M',
      step: [
        { '@type': 'HowToStep', position: 1, name: 'Open a GIF', text: 'Upload a GIF file, paste it from the clipboard, or load it from a URL.' },
        { '@type': 'HowToStep', position: 2, name: 'Select frames', text: 'Choose all frames, a range, or every Nth frame in the filmstrip.' },
        { '@type': 'HowToStep', position: 3, name: 'Export frames', text: 'Choose an output format and download the current frame or the selected frames as ZIP.' },
      ],
    },
    {
      '@type': 'ImageObject',
      name: 'Sample GIF frame output',
      contentUrl: absoluteOgImage,
      thumbnailUrl: absoluteOgImage,
      caption: 'Eight numbered frames extracted from a sample GIF',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'GIF to Frames',
          item: 'https://gif-to-frames.com/',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    },
  ],
});
---

<BaseLayout title={title} description={description} ogImage="/demo/frame-01.png" schema={schema}>
  <GifFrameTool
    h1="GIF to Frames: Split GIF into PNG, JPG or WebP"
    lead="Split any animated GIF into individual images. Preview every frame with adjustable playback, select a range or every Nth frame, then export PNG, JPG, or WebP as a ZIP."
    accept="image/gif,.gif,image/webp,.webp,image/apng,.apng,image/png,.png"
    uploadTitle="Drop your GIF, WebP, or APNG here"
    uploadHint="Choose an animated GIF, WebP, or APNG file, paste it, or load from a URL. Processing stays in your browser."
    selectLabel="Select animation"
    sampleLabel="Try sample GIF"
    urlPlaceholder="Paste a GIF, WebP, or APNG URL"
  />

  <section class="mx-auto max-w-[1400px] px-4 pb-20 sm:px-6">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">Sample output: one GIF, eight frames</h2>
      <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-ink-muted dark:text-emerald-50/60">
        The sample animation becomes eight numbered images. Upload your own GIF to preview and select the exact frames you need.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
      {
        demoFrames.map((frame) => {
          const number = String(frame).padStart(2, '0');
          return (
            <figure class="overflow-hidden rounded-md border border-line bg-canvas/70 dark:border-white/10 dark:bg-white/5">
              <img src={`/demo/frame-${number}.png`} alt={`Sample GIF frame ${number}`} loading="lazy" decoding="async" width="240" height="160" class="aspect-square w-full object-cover" />
              <figcaption class="border-t border-line px-3 py-2 font-mono text-xs text-ink-muted dark:border-white/10 dark:text-emerald-50/55">frame-{number}.png</figcaption>
            </figure>
          );
        })
      }
    </div>
  </section>

  <section id="popular-conversions" class="mx-auto max-w-[1400px] px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">Popular GIF frame conversions</h2>
      <p class="mt-4 max-w-[60ch] text-base leading-relaxed text-ink-muted dark:text-emerald-50/60">
        Jump straight to the output or workflow you need. Every conversion runs locally in your browser.
      </p>
    </div>

    <div class="mt-8 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
      <a href="/gif-to-png-frames" class="rounded-md border border-line bg-canvas/70 p-5 transition-colors hover:border-accent/40 dark:border-white/10 dark:bg-white/5">
        <Icon name="tabler:file-type-png" class="h-5 w-5 text-accent" />
        <h3 class="mt-4 text-base font-semibold text-ink dark:text-white">GIF to PNG frames</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/55">
          Export lossless frames with transparency for design, sprites, and video editing.
        </p>
      </a>
      <a href="/gif-to-jpg-frames" class="rounded-md border border-line bg-canvas/70 p-5 transition-colors hover:border-accent/40 dark:border-white/10 dark:bg-white/5">
        <Icon name="tabler:file-type-jpg" class="h-5 w-5 text-accent" />
        <h3 class="mt-4 text-base font-semibold text-ink dark:text-white">GIF to JPG frames</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/55">
          Create smaller flattened frames for slides, social posts, and quick sharing.
        </p>
      </a>
      <a href="/gif-to-webp-frames" class="rounded-md border border-line bg-canvas/70 p-5 transition-colors hover:border-accent/40 dark:border-white/10 dark:bg-white/5">
        <Icon name="tabler:file" class="h-5 w-5 text-accent" />
        <h3 class="mt-4 text-base font-semibold text-ink dark:text-white">GIF to WebP frames</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/55">
          Export modern web assets with transparency and a smaller file size.
        </p>
      </a>
      <a href="/gif-to-zip-frames" class="rounded-md border border-line bg-canvas/70 p-5 transition-colors hover:border-accent/40 dark:border-white/10 dark:bg-white/5">
        <Icon name="tabler:archive" class="h-5 w-5 text-accent" />
        <h3 class="mt-4 text-base font-semibold text-ink dark:text-white">GIF to ZIP frames</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/55">
          Package selected frames into one archive with predictable file names.
        </p>
      </a>
      <a href="/gif-frame-metadata" class="rounded-md border border-line bg-canvas/70 p-5 transition-colors hover:border-accent/40 dark:border-white/10 dark:bg-white/5">
        <Icon name="tabler:json" class="h-5 w-5 text-accent" />
        <h3 class="mt-4 text-base font-semibold text-ink dark:text-white">GIF frame metadata</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/55">
          Inspect delay, size, offset, disposal, and transparency, then export JSON or CSV.
        </p>
      </a>
      <a href="/gif-to-sprite-sheet" class="rounded-md border border-line bg-canvas/70 p-5 transition-colors hover:border-accent/40 dark:border-white/10 dark:bg-white/5">
        <Icon name="tabler:grid-dots" class="h-5 w-5 text-accent" />
        <h3 class="mt-4 text-base font-semibold text-ink dark:text-white">GIF to sprite sheet</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/55">
          Arrange selected frames into one PNG sprite sheet for games and UI animation.
        </p>
      </a>
    </div>
  </section>

  <FramesToGifTool
    showSchema
    sectionId="frames-to-gif"
    titleLevel="h2"
    h1="Frames to GIF"
    lead="Upload PNG, JPG, or WebP frames, drag them into order, and create a clean animated GIF."
  />

  <section id="guide" class="mx-auto max-w-[1400px] px-4 py-20 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
      <div class="max-w-4xl space-y-14">
        <article>
          <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">What is GIF frame extraction?</h2>
          <div class="mt-6 space-y-4 text-base leading-relaxed text-ink-muted dark:text-emerald-50/60">
            <p>
              An animated GIF is not a single image. It is a compact container made from multiple still images called frames, along with timing and compositing information. Frame extraction reads that container, renders each frame in order, and exports the frames as separate image files.
            </p>
            <p>
              This is useful when a GIF contains a specific pose, icon, product state, animation step, or visual reference that you need outside the animated file. Instead of taking screenshots or editing the GIF manually, the tool gives you the original frames with predictable file names and selectable output settings.
            </p>
            <ul class="list-disc space-y-2 pl-5">
              <li>Extract a single first or last frame for a cover image.</li>
              <li>Export a complete image sequence for After Effects, Premiere, or CapCut.</li>
              <li>Build a sprite sheet for games and web animation.</li>
              <li>Inspect delay, dimensions, disposal, and transparency before rebuilding an animation.</li>
            </ul>
          </div>
        </article>

        <article id="formats">
          <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">How to choose the best output format</h2>
          <div class="mt-6 overflow-x-auto rounded-md border border-line bg-canvas/70 dark:border-white/10 dark:bg-white/5">
            <table class="w-full min-w-[720px] border-collapse text-left text-sm">
              <thead class="border-b border-line text-xs uppercase tracking-[0.12em] text-ink-muted dark:border-white/10 dark:text-emerald-50/55">
                <tr>
                  <th class="px-4 py-3 font-medium">Format</th>
                  <th class="px-4 py-3 font-medium">Best for</th>
                  <th class="px-4 py-3 font-medium">Transparency</th>
                  <th class="px-4 py-3 font-medium">File size</th>
                  <th class="px-4 py-3 font-medium">Typical use</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-line dark:divide-white/10">
                <tr>
                  <td class="px-4 py-3 font-semibold text-ink dark:text-white">PNG</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">Lossless output, clean edges, UI and game assets</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">Yes</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">Larger</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">Design, sprites, video editing</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-semibold text-ink dark:text-white">JPG</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">Photos, slides, social posts, lighter sequences</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">No</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">Smaller</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">Documents, sharing, previews</td>
                </tr>
                <tr>
                  <td class="px-4 py-3 font-semibold text-ink dark:text-white">WebP</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">Modern web assets with good quality and smaller files</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">Yes</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">Small</td>
                  <td class="px-4 py-3 text-ink-muted dark:text-emerald-50/65">Web, app, content workflows</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="mt-5 text-base leading-relaxed text-ink-muted dark:text-emerald-50/60">
            Use PNG when quality and transparency are more important than file size. Use WebP when you need modern, efficient web output. Use JPG when you need maximum compatibility and smaller flattened stills.
          </p>
        </article>

        <article id="metadata-guide">
          <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">Understanding GIF frame metadata</h2>
          <div class="mt-6 grid gap-3 sm:grid-cols-2">
            <div class="rounded-md border border-line bg-canvas/70 p-5 dark:border-white/10 dark:bg-white/5">
              <h3 class="text-base font-semibold text-ink dark:text-white">Frame delay</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/60">The time a frame remains visible before the next frame appears. Short delays create fast motion; long delays create pauses.</p>
            </div>
            <div class="rounded-md border border-line bg-canvas/70 p-5 dark:border-white/10 dark:bg-white/5">
              <h3 class="text-base font-semibold text-ink dark:text-white">Frame dimensions and offset</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/60">GIF frames can be smaller than the full canvas and positioned at a specific offset. The metadata table shows these values for every frame.</p>
            </div>
            <div class="rounded-md border border-line bg-canvas/70 p-5 dark:border-white/10 dark:bg-white/5">
              <h3 class="text-base font-semibold text-ink dark:text-white">Disposal</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/60">Disposal controls whether the previous frame is kept, cleared, or restored before drawing the next one. It matters when rebuilding transparent or partial-frame animations.</p>
            </div>
            <div class="rounded-md border border-line bg-canvas/70 p-5 dark:border-white/10 dark:bg-white/5">
              <h3 class="text-base font-semibold text-ink dark:text-white">Transparency</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/60">A frame may include transparent pixels. PNG and WebP preserve alpha. JPG flattens transparent areas to white because it does not support transparency.</p>
            </div>
          </div>
          <p class="mt-5 text-base leading-relaxed text-ink-muted dark:text-emerald-50/60">
            Use the JSON or CSV export when you need to feed frame timing and dimensions into a build script, spreadsheet, QA process, or animation pipeline.
          </p>
        </article>

        <article id="workflows">
          <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">Common frame workflows</h2>
          <div class="mt-6 grid gap-3 md:grid-cols-2">
            <div class="rounded-md border border-line bg-canvas/70 p-5 dark:border-white/10 dark:bg-white/5">
              <h3 class="text-base font-semibold text-ink dark:text-white">After Effects and video editing</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/60">Export PNG frames with a numbered naming pattern, import the sequence into After Effects, Premiere, or CapCut, and use the original frame delay as a timing reference.</p>
            </div>
            <div class="rounded-md border border-line bg-canvas/70 p-5 dark:border-white/10 dark:bg-white/5">
              <h3 class="text-base font-semibold text-ink dark:text-white">Game and UI animation</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/60">Select the frames you need, export a sprite sheet, or keep individual PNG frames with alpha for engines, UI tools, and CSS animation.</p>
            </div>
            <div class="rounded-md border border-line bg-canvas/70 p-5 dark:border-white/10 dark:bg-white/5">
              <h3 class="text-base font-semibold text-ink dark:text-white">Content and social media</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/60">Extract the first, last, or clearest frame for a thumbnail, avatar, article image, or social post without installing an editor.</p>
            </div>
            <div class="rounded-md border border-line bg-canvas/70 p-5 dark:border-white/10 dark:bg-white/5">
              <h3 class="text-base font-semibold text-ink dark:text-white">QA and animation inspection</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-muted dark:text-emerald-50/60">Review frame order, delay, transparency, and disposal. Export metadata as CSV to document issues or compare multiple animation versions.</p>
            </div>
          </div>
        </article>

        <article id="developer-guide">
          <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">Developer quick reference</h2>
          <div class="mt-6 grid gap-4 md:grid-cols-2">
            <div class="rounded-md border border-line bg-canvas/70 p-4 dark:border-white/10 dark:bg-white/5">
              <h3 class="text-sm font-semibold text-ink dark:text-white">Python with Pillow</h3>
              <pre class="mt-3 overflow-x-auto rounded-md bg-ink p-4 font-mono text-xs leading-relaxed text-emerald-50 dark:bg-black/40"><code>from PIL import Image

with Image.open("animation.gif") as im:
    for index in range(im.n_frames):
        im.seek(index)
        im.save("frame_" + str(index).zfill(3) + ".png")
</code></pre>
            </div>
            <div class="rounded-md border border-line bg-canvas/70 p-4 dark:border-white/10 dark:bg-white/5">
              <h3 class="text-sm font-semibold text-ink dark:text-white">FFmpeg</h3>
              <pre class="mt-3 overflow-x-auto rounded-md bg-ink p-4 font-mono text-xs leading-relaxed text-emerald-50 dark:bg-black/40"><code>ffmpeg -i animation.gif frame_%03d.png

ffmpeg -i animation.gif -vf "select=not(mod(n\,5))" -vsync vfr frame_%03d.png
</code></pre>
            </div>
          </div>
          <p class="mt-5 text-base leading-relaxed text-ink-muted dark:text-emerald-50/60">
            Use the browser tool when you need a fast visual workflow. Use these commands when you need frame extraction inside an automated script, server process, or local development pipeline. See the <a href="https://pillow.readthedocs.io/en/stable/reference/Image.html" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Pillow Image docs</a> and the <a href="https://ffmpeg.org/documentation.html" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">FFmpeg documentation</a> for full reference.
          </p>
        </article>

        <article id="local-processing">
          <h2 class="text-3xl font-semibold tracking-tight text-ink sm:text-4xl dark:text-white">Why local processing matters</h2>
          <div class="mt-6 space-y-4 text-base leading-relaxed text-ink-muted dark:text-emerald-50/60">
            <p>
